library(tidymodels)
library(ggplot2)
library(dplyr)
library(purrr)
library(broom)
library(readr)
library(RColorBrewer)
library(vip)
set.seed(42)
# Load and prepare the data
df <- read_csv("w2-child-scored.csv") %>%
select(-SID, -c2init, -c2stid, -c2demB, -VAR00001)
# Extract all column names as potential targets
targets <- names(df)
# Function to run Random Forest model for a given target
run_rf_model <- function(target, data) {
# Remove rows with missing target values
data_clean <- data %>% filter(!is.na(.data[[target]]))
# Skip if there are too few rows to model
if (nrow(data_clean) < 10) {
message(glue::glue("Skipping {target}: Not enough rows after filtering."))
return(NULL)
}
rec <- recipe(as.formula(paste(target, "~ .")), data = data_clean) %>%
step_normalize(all_predictors())
rf_spec <- rand_forest(mtry = tune(), trees = 500, min_n = tune()) %>%
set_engine("ranger", importance = "permutation") %>%
set_mode("regression")
wf <- workflow() %>%
add_model(rf_spec) %>%
add_recipe(rec)
folds <- vfold_cv(data_clean, v = 5, repeats = 3)
rf_grid <- grid_regular(
mtry(range = c(2, 10)),
min_n(range = c(2, 10)),
levels = 3
)
tuned <- tune_grid(
wf,
resamples = folds,
grid = rf_grid,
metrics = metric_set(rmse, rsq),
control = control_grid(save_pred = TRUE)
)
best_params <- select_best(tuned, metric = "rsq")
final_wf <- finalize_workflow(wf, best_params)
final_fit <- fit(final_wf, data = data_clean)
preds_train <- predict(final_fit, data_clean) %>%
bind_cols(truth = data_clean[[target]]) %>%
rename(prediction = .pred)
rsq_train <- rsq(preds_train, truth = truth, estimate = prediction) %>%
pull(.estimate)
rsq_cv <- tuned %>%
collect_metrics() %>%
filter(.metric == "rsq") %>%
summarise(cv_rsq = max(mean)) %>%
pull(cv_rsq)
vip <- final_fit %>%
extract_fit_parsnip() %>%
vip::vi() %>%
rename(term = Variable, importance = Importance) %>%
mutate(
Target = target,
term = gsub("`", "", term)
)
list(
target = target,
rsq_train = rsq_train,
rsq_cv = rsq_cv,
importances = vip
)
}
# Run model for each target
results_rf <- map(targets, ~ run_rf_model(.x, df)) %>%
compact()  # Remove NULL results
# Define pastel palette
pastel_palette <- brewer.pal(8, "Pastel2")
# Plot each target’s importances individually
walk(results_rf, function(res) {
n_features <- nrow(res$importances)
colors <- rep(pastel_palette, length.out = n_features)
p <- ggplot(res$importances, aes(x = reorder(term, importance), y = importance)) +
geom_col(fill = colors) +
coord_flip() +
theme_minimal(base_size = 14) +
labs(
title = paste("Random Forest Feature Importances for:", res$target),
subtitle = paste0("R² (Train): ", round(res$rsq_train, 3),
" | R² (CV): ", round(res$rsq_cv, 3)),
x = "Features", y = "Importance (Permutation)"
)
print(p)
})
library(tidyverse)
data <- read_csv("aggregated-w3-sleep.csv")
data |>
ggplot(aes(x = c3tstall)) +
geom_density(fill = "lightblue", alpha = 0.5) +
labs(
title = "Probability Density Plot of Stall Time",
x = "Stall Time (c3tstall)",
y = "Density"
) +
theme_minimal()
data |>
ggplot(aes(x = c3sleff)) +
geom_density(fill = "lightblue", alpha = 0.5) +
labs(
title = "Probability Density Plot of Sleep Efficiency",
x = "Stall Time (c3tstall)",
y = "Density"
) +
theme_minimal()
data |>
ggplot(aes(sample = c3tstall)) +
stat_qq(color = "steelblue") +
stat_qq_line(color = "red", linetype = "dashed") +
labs(
title = "Q-Q Plot of Stall Time",
x = "Theoretical Quantiles",
y = "Sample Quantiles"
) +
theme_minimal()
data |>
ggplot(aes(sample = c3sleff)) +
stat_qq(color = "steelblue") +
stat_qq_line(color = "red", linetype = "dashed") +
labs(
title = "Q-Q Plot of Stall Time",
x = "Theoretical Quantiles",
y = "Sample Quantiles"
) +
theme_minimal()
library(broom)
library(gt)  # or use kableExtra
# Run the test
shapiro.test(na.omit(data$c3tstall))
shapiro.test(na.omit(data$c3sleff))
library(ggplot2)
library(ggpubr)
data |>
ggplot(aes(x = c3tstall, y = c3sleff)) +
geom_point() +
geom_smooth(method = "lm", se = TRUE, color = "blue") +
stat_cor(method = "pearson", label.x = 300, label.y = 90) +  # Customize label position
labs(
title = "Scatter Plot with Correlation Coefficient",
x = "Stall Time (c3tstall)",
y = "Sleep Efficiency (c3sleff)"
) +
theme_minimal()
library(tidymodels)
library(ggplot2)
library(dplyr)
library(purrr)
library(broom)
library(readr)
library(RColorBrewer)
library(vip)
library(glue)
set.seed(42)
# Load and prepare the data
df <- read_csv("w2-child-scored.csv") %>%
select(-SID, -c2init, -c2stid, -c2demB, -VAR00001)
# Extract all column names as potential targets
targets <- names(df)
# Function to run XGBoost model for a given target
run_xgb_model <- function(target, data) {
# Remove rows with missing target values
data_clean <- data %>% filter(!is.na(.data[[target]]))
# Skip if too few rows
if (nrow(data_clean) < 10) {
message(glue("Skipping {target}: Not enough rows after filtering."))
return(NULL)
}
rec <- recipe(as.formula(paste(target, "~ .")), data = data_clean) %>%
step_normalize(all_predictors())
xgb_spec <- boost_tree(
trees = tune(),
tree_depth = tune(),
learn_rate = tune()
) %>%
set_engine("xgboost") %>%
set_mode("regression")
wf <- workflow() %>%
add_model(xgb_spec) %>%
add_recipe(rec)
folds <- vfold_cv(data_clean, v = 5, repeats = 3)
xgb_grid <- grid_regular(
trees(range = c(100, 500)),
tree_depth(range = c(2, 10)),
learn_rate(range = c(0.01, 0.3)),
levels = 3
)
tuned <- tune_grid(
wf,
resamples = folds,
grid = xgb_grid,
metrics = metric_set(rmse, rsq),
control = control_grid(save_pred = TRUE)
)
best_params <- select_best(tuned, metric = "rsq")
final_wf <- finalize_workflow(wf, best_params)
final_fit <- fit(final_wf, data = data_clean)
preds_train <- predict(final_fit, data_clean) %>%
bind_cols(truth = data_clean[[target]]) %>%
rename(prediction = .pred)
rsq_train <- rsq(preds_train, truth = truth, estimate = prediction) %>%
pull(.estimate)
rsq_cv <- tuned %>%
collect_metrics() %>%
filter(.metric == "rsq") %>%
summarise(cv_rsq = max(mean)) %>%
pull(cv_rsq)
vip <- final_fit %>%
extract_fit_parsnip() %>%
vip::vi() %>%
rename(term = Variable, importance = Importance) %>%
mutate(
Target = target,
term = gsub("`", "", term)
)
list(
target = target,
rsq_train = rsq_train,
rsq_cv = rsq_cv,
importances = vip
)
}
# Run model for each target
results_xgb <- map(targets, ~ run_xgb_model(.x, df)) %>%
compact()  # Remove NULL results
# Define pastel palette
pastel_palette <- brewer.pal(8, "Pastel2")
# Plot each target’s importances individually
walk(results_xgb, function(res) {
n_features <- nrow(res$importances)
colors <- rep(pastel_palette, length.out = n_features)
p <- ggplot(res$importances, aes(x = reorder(term, importance), y = importance)) +
geom_col(fill = colors) +
coord_flip() +
theme_minimal(base_size = 14) +
labs(
title = paste("XGBoost Feature Importances for:", res$target),
subtitle = paste0("R² (Train): ", round(res$rsq_train, 3),
" | R² (CV): ", round(res$rsq_cv, 3)),
x = "Features", y = "Importance (Gain)"
)
print(p)
})
