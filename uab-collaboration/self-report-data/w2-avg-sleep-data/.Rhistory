preds_train <- predict(final_fit, data) %>%
bind_cols(data %>% select(!!target))
colnames(preds_train) <- c("prediction", "truth")
rsq_train <- rsq(preds_train, truth = truth, estimate = prediction) %>%
pull(.estimate)
# Cross-validated R²
rsq_cv <- tuned %>%
collect_metrics() %>%
filter(.metric == "rsq") %>%
summarise(cv_rsq = max(mean)) %>%
pull(cv_rsq)
# Get feature importances
vip <- final_fit %>%
extract_fit_parsnip() %>%
vip::vi() %>%
rename(term = Variable, importance = Importance) %>%
mutate(
Target = target,
term = gsub("`", "", term)
)
list(
target = target,
rsq_train = rsq_train,
rsq_cv = rsq_cv,
importances = vip
)
}
# Run model for each target
results_rf <- map(targets, ~ run_rf_model(.x, df))
install.packages("ranger")
library(tidymodels)
library(ggplot2)
library(dplyr)
library(purrr)
library(broom)
library(readr)
library(RColorBrewer)
set.seed(42)
# Load and prepare the data
df <- read_csv("w2-child-scored.csv") |>
select(-SID, -c2init, -c2stid, -c2demB, -VAR00001)
targets <- names(df)
# Function to run Random Forest model for a given target
run_rf_model <- function(target, data) {
rec <- recipe(as.formula(paste(target, "~ .")), data = data) %>%
step_normalize(all_predictors())  # Not required for RFs but fine to include
rf_spec <- rand_forest(mtry = tune(), trees = 500, min_n = tune()) %>%
set_engine("ranger", importance = "permutation") %>%
set_mode("regression")
wf <- workflow() %>%
add_model(rf_spec) %>%
add_recipe(rec)
folds <- vfold_cv(data, v = 5, repeats = 3)
# Tune the RF
rf_grid <- grid_regular(
mtry(range = c(2, 10)),
min_n(range = c(2, 10)),
levels = 3
)
tuned <- tune_grid(
wf,
resamples = folds,
grid = rf_grid,
metrics = metric_set(rmse, rsq),
control = control_grid(save_pred = TRUE)
)
best_params <- select_best(tuned, "rsq")
final_wf <- finalize_workflow(wf, best_params)
final_fit <- fit(final_wf, data = data)
# Training set R²
preds_train <- predict(final_fit, data) %>%
bind_cols(data %>% select(!!target))
colnames(preds_train) <- c("prediction", "truth")
rsq_train <- rsq(preds_train, truth = truth, estimate = prediction) %>%
pull(.estimate)
# Cross-validated R²
rsq_cv <- tuned %>%
collect_metrics() %>%
filter(.metric == "rsq") %>%
summarise(cv_rsq = max(mean)) %>%
pull(cv_rsq)
# Get feature importances
vip <- final_fit %>%
extract_fit_parsnip() %>%
vip::vi() %>%
rename(term = Variable, importance = Importance) %>%
mutate(
Target = target,
term = gsub("`", "", term)
)
list(
target = target,
rsq_train = rsq_train,
rsq_cv = rsq_cv,
importances = vip
)
}
# Run model for each target
results_rf <- map(targets, ~ run_rf_model(.x, df))
