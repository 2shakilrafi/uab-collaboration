# Load necessary libraries
library(tidyverse)
library(readr)
# Read the dataset
df <- read_csv("W1 Physical Activity.csv")
# Remove non-relevant columns
df_clean <- df %>% select(-Subject, -Filename, -Epoch)
# Select only numeric columns
numeric_df <- df_clean %>% select(where(is.numeric))
# Loop through numeric columns and display density plots
for (col_name in colnames(numeric_df)) {
p <- ggplot(numeric_df, aes_string(x = col_name)) +
geom_density(fill = "steelblue", alpha = 0.6) +
labs(title = paste("Density Plot of", col_name),
x = col_name,
y = "Density") +
theme_minimal()
print(p)
}
# Load libraries
library(tidyverse)
library(readr)
# Load the dataset
df <- read_csv("W1 Physical Activity.csv")
# Drop non-numeric columns
df_clean <- df %>% select(-Subject, -Filename, -Epoch)
# Select only numeric columns
numeric_df <- df_clean %>% select(where(is.numeric))
# Apply Shapiro-Wilk test and store results
shapiro_results <- map_dfr(names(numeric_df), function(var) {
values <- numeric_df[[var]]
if (length(unique(values)) < 3) {
tibble(Variable = var, W = NA, p_value = NA, Note = "Too few unique values")
} else {
test <- shapiro.test(values)
tibble(Variable = var, W = round(test$statistic, 4), p_value = round(test$p.value, 4), Note = NA)
}
})
# View result
print(shapiro_results)
# Load libraries
library(tidyverse)
library(readr)
# Load the data
df <- read_csv("W1 Physical Activity.csv")
# Remove irrelevant columns
df_clean <- df %>%
select(-Subject, -Filename, -Epoch)
# Ensure Age is a factor (for grouping on x-axis and coloring)
df_clean <- df_clean %>%
mutate(Age = as.factor(Age))
# Select numeric columns excluding Age itself
numeric_vars <- df_clean %>%
select(where(is.numeric))
# Loop through numeric variables and generate violin plots grouped by Age
for (var in names(numeric_vars)) {
p <- ggplot(df_clean, aes(x = Age, y = .data[[var]], fill = Age)) +
geom_violin(alpha = 0.7) +
geom_boxplot(width = 0.1, outlier.shape = NA, fill = "white", alpha = 0.6) +
scale_fill_brewer(palette = "Pastel1") +
labs(title = paste("Violin Plot of", var, "by Age"),
x = "Age",
y = var) +
theme_minimal() +
theme(legend.position = "none")
print(p)
}
# Load libraries
library(tidyverse)
library(readr)
library(reshape2)
library(ggplot2)
# ==== USER INPUT ====
plot_width <- 20    # in inches
plot_height <- 10   # in inches
# ====================
# Load the dataset
df <- read_csv("W1 Physical Activity.csv")
# Remove irrelevant columns
df_clean <- df %>% select(-Subject, -Filename, -Epoch)
# Keep only numeric columns and drop rows with NA
numeric_df <- df_clean %>%
select(where(is.numeric)) %>%
drop_na()
# Scale the data (z-score standardization)
scaled_df <- scale(numeric_df)
# Compute correlation matrix
cor_matrix <- cor(scaled_df)
# Melt the matrix for ggplot
cor_melted <- melt(cor_matrix)
# Create the plot
p <- ggplot(cor_melted, aes(x = Var1, y = Var2, fill = value)) +
geom_tile(color = "white") +
scale_fill_gradient2(
low = "#B3E2CD", high = "#FDCDAC", mid = "white",
midpoint = 0, limit = c(-1, 1), space = "Lab",
name = "Pearson\nCorrelation"
) +
theme_minimal(base_size = 14) +
theme(
axis.text.x = element_text(angle = 45, vjust = 1, hjust = 1, size = 10),
axis.text.y = element_text(size = 10),
plot.title = element_text(size = 18, face = "bold", hjust = 0.5),
panel.grid = element_blank(),
legend.title = element_text(size = 12),
legend.text = element_text(size = 10)
) +
coord_fixed() +
labs(
title = "Correlation Heatmap of Scaled Physical Activity Variables",
x = "", y = ""
)
# Display it in specified size
print(p)
# If in RStudio and you want to export:
# ggsave("correlation_heatmap.png", plot = p, width = plot_width, height = plot_height, dpi = 300)
# Load required libraries
library(tidyverse)
library(readr)
library(plotly)
# ==== USER INPUT ====
plot_width <- 1000  # in pixels
plot_height <- 800  # in pixels
# ====================
# Load data
df <- read_csv("W1 Physical Activity.csv")
# Clean and preprocess
df_clean <- df %>%
select(-Subject, -Filename, -Epoch) %>%
select(where(is.numeric)) %>%
drop_na()
# Scale the data (z-score)
scaled_df <- scale(df_clean)
# Compute correlation matrix
cor_matrix <- cor(scaled_df)
p <- plot_ly(
x = colnames(cor_matrix),
y = rownames(cor_matrix),
z = cor_matrix,
type = "heatmap",
colorscale = "RdBu",
zmin = -1,
zmax = 1,
reversescale = TRUE
) %>%
layout(
title = "Correlation Heatmap of Scaled Physical Activity Variables",
xaxis = list(title = "", tickangle = 45),
yaxis = list(title = "", autorange = "reversed"),
width = plot_width,
height = plot_height,
margin = list(l = 100, r = 20, b = 100, t = 100)
)
# Save as interactive HTML
htmlwidgets::saveWidget(p, "correlation_heatmap.html")
data
library(ggplot2)
library(dplyr)
data |>
filter(Age %in% c(11, 12, 13)) |>  # keep only desired ages
mutate(Age = as.factor(Age)) |>   # convert to categorical
select(METs, StepsCounts, Age) |>
ggplot(aes(x = METs, y = StepsCounts, color = Age)) +
geom_point(size = 2, alpha = 0.7) +
scale_color_manual(values = c("11" = "red", "12" = "blue", "13" = "green")) + # optional custom colors
theme_minimal() +
labs(title = "Steps vs METs by Age Group", color = "Age")
library(ggplot2)
library(dplyr)
library(ggpubr)
data |>
filter(Age %in% c(11, 12, 13)) |>
mutate(Age = as.factor(Age)) |>
select(METs, StepsCounts, Age) |>
ggplot(aes(x = METs, y = StepsCounts)) +
geom_point(aes(color = Age), size = 2, alpha = 0.7) +
geom_smooth(method = "lm", se = TRUE, color = "black", fill = "grey70", alpha = 0.3) +  # overall best-fit line
stat_cor(method = "pearson", label.x.npc = "left", label.y.npc = "top", size = 5) +
scale_color_manual(values = c("11" = "red", "12" = "blue", "13" = "green")) +
theme_minimal() +
labs(title = "Steps vs METs by Age Group", color = "Age")
